# The web app defaults to local auth when this is omitted.
FORMA_AUTH_MODE=local

# Backend endpoint used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional OpenCAD backend. Defaults to NEXT_PUBLIC_API_URL in development.
# NEXT_PUBLIC_OPENCAD_URL=http://localhost:8000
# NEXT_PUBLIC_OPENCAD_KERNEL_URL=http://localhost:8000/kernel

# Enable local-only developer controls in Next development mode.
# NEXT_PUBLIC_FORMA_DEV_MODE=true
